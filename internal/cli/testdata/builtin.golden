{"ok":false,"error":{"code":"usage","message":"no built-in palette \"nosuch\"","hint":"use one of default, sweetie16, or none","arg":"palette"}}

$ pxo new pal.pxo --size 4x4 --bg ink --json
exit 0
--- stdout
{"ok":true,"rev":0,"changed":16,"bbox":[0,0,4,4],"warnings":[]}

$ pxo palette list pal.pxo
exit 0
--- stdout
o  #1a1c2c  ink
p  #5d275d  plum
r  #b13e53  red
c  #ef7d57  coral
y  #ffcd75  yellow
l  #a7f070  lime
g  #38b764  green
t  #257179  teal
n  #29366f  navy
b  #3b5dc9  blue
s  #41a6f6  sky
i  #73eff7  ice
w  #f4f4f4  white
f  #94b0c2  fog
a  #566c86  ash
d  #333c57  dusk
ramp blue   n [b] s i
ramp gray   o d [a] f w
ramp green  t [g] l
ramp warm   p r [c] y

$ pxo use pal.pxo
exit 0
