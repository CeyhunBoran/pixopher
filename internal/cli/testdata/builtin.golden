{"ok":true,"rev":0,"changed":0,"warnings":[]}

$ pxo new hero.pxo
exit 2
--- stderr
error[file_exists]: hero.pxo already exists
hint: pass --force to replace it (its history is removed too)

$ pxo new hero --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"document \"hero\" must end in .pxo","hint":"use a name like hero.pxo","arg":"file"}}

$ pxo new big.pxo --size 2000x10 --json
exit 2
--- stdout
{"ok":false,"error":{"code":"too_large","message":"size 2000x10 is too large","hint":"the maximum canvas is 1024x1024","arg":"size"}}

