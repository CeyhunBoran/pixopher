$ pxo px 16,0 #000000 --json
exit 2
--- stdout
{"ok":false,"error":{"code":"out_of_bounds","message":"x=16 is outside the canvas","hint":"canvas is 16x16; valid x is 0..15","arg":"at"}}

$ pxo px 1,1 #000000 2,2 --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"missing argument <color> to complete the last group","hint":"color repeats as a group: <at> <color> [<at> <color> ...]","arg":"color"}}

$ pxo px 1,1 nosuch --json
exit 2
--- stdout
{"ok":false,"error":{"code":"unknown_color","message":"unknown color \"nosuch\"","arg":"color"}}

$ pxo line 0,0 3,3 #000000 --width 0 --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"bad width 0","hint":"width is 1..64","arg":"width"}}

$ pxo fill 0,99 #000000
exit 2
--- stderr
error[out_of_bounds]: y=99 is outside the canvas
hint: canvas is 16x16; valid y is 0..15

$ pxo new -f hero.pxo x.pxo --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"unknown flag -f","hint":"see `pixopher new --help`"}}

$ pxo info nosuch.pxo --json
exit 4
--- stdout
{"ok":false,"error":{"code":"no_file","message":"nosuch.pxo does not exist","hint":"create it with `pxo new nosuch.pxo --size 32x32`"}}

$ pxo info extra --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"unexpected argument \"extra\"","hint":"see `pixopher info --help`"}}

$ pxo info -m note --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"unknown flag -m","hint":"see `pixopher info --help`"}}

$ pxo info --dry-run
exit 1
--- stderr
error[usage]: unknown flag --dry-run
hint: see `pixopher info --help`

$ pxo info --expect-rev 3 --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"unknown flag --expect-rev","hint":"see `pixopher info --help`"}}

$ pxo px --help
exit 0
--- stdout
Set pixels, each to its own color

Arguments:
  at     point x,y; pixel on the canvas
  color  color: key, name, ramp step, #hex or .

Usage:
  pixopher px <at> <color> [<at> <color> ...] [flags]

Examples:
  pxo px 3,4 ink
  pxo px 3,4 ink 4,4 skin 5,4 .

Flags:
      --as string        author label (default $PIXOPHER_AUTHOR or cli)
      --dry-run          report the change without writing anything
      --expect-rev int   fail with rev_conflict unless the document is at this rev
  -f, --file string      document to act on (default: $PIXOPHER_FILE, the file set by use, or the only *.pxo here)
  -h, --help             help for px
  -m, --message string   caption for this transaction

Global Flags:
      --json   machine-readable output (PIXOPHER_JSON=1 turns it on everywhere)

$ pxo new --help
exit 0
--- stdout
Create a document

Arguments:
  file  text; path of the new document, ending in .pxo

Usage:
  pixopher new <file> [flags]

Examples:
  pxo new hero.pxo
  pxo new icon.pxo --size 16x16 --bg '#1a1c2c'

Flags:
      --bg color    fill the canvas with this color (a #hex color adds an entry)
      --dry-run     report the change without writing anything
      --force       replace an existing document and remove its history
  -h, --help        help for new
      --size size   canvas size, up to 1024x1024 (default 32x32)

Global Flags:
      --json   machine-readable output (PIXOPHER_JSON=1 turns it on everywhere)

$ pxo info --help
exit 0
--- stdout
Show the document's size, rev, palette size, layers, frames, regions and anchors

Usage:
  pixopher info [flags]

Examples:
  pxo info
  pxo info hero.pxo --json

Flags:
  -f, --file string   document to act on (default: $PIXOPHER_FILE, the file set by use, or the only *.pxo here)
  -h, --help          help for info

Global Flags:
      --json   machine-readable output (PIXOPHER_JSON=1 turns it on everywhere)

