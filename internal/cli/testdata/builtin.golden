using pal.pxo

$ pxo palette add k #ffcc99 skin --json
exit 0
--- stdout
{"ok":true,"rev":1,"changed":0,"warnings":[]}

$ pxo palette add k #000000 other --json
exit 2
--- stdout
{"ok":false,"error":{"code":"already_exists","message":"palette key \"k\" is taken by \"skin\"","hint":"pick another key","arg":"key"}}

$ pxo palette set skin #ffd0a0
exit 0
--- stdout
ok rev 2  +0px

$ pxo palette rename skin flesh --json
exit 0
--- stdout
{"ok":true,"rev":3,"changed":0,"warnings":[]}

$ pxo ramp add flesh c k y --base k --json
exit 0
--- stdout
{"ok":true,"rev":4,"changed":0,"warnings":[]}

$ pxo px 0,0 flesh 1,0 flesh-1 2,0 flesh+1
exit 0
--- stdout
ok rev 5  +3px  bbox 0,0 3,1

$ pxo palette rm flesh --json
exit 2
--- stdout
{"ok":false,"error":{"code":"in_use","message":"palette entry \"flesh\" is a step of ramp \"flesh\"","hint":"remove the ramp first: ramp rm flesh","arg":"entry"}}

$ pxo ramp rm flesh
exit 0
--- stdout
ok rev 6  +0px

$ pxo palette rm flesh --json
exit 2
--- stdout
{"ok":false,"error":{"code":"in_use","message":"palette entry \"flesh\" is used by 1 pixel","hint":"repaint them with --replace <color>, or erase them first","arg":"entry"}}

$ pxo palette rm flesh --replace coral --json
exit 0
--- stdout
{"ok":true,"rev":7,"changed":1,"bbox":[0,0,1,1],"warnings":[]}

$ pxo undo --json
exit 0
--- stdout
{"ok":true,"rev":8,"changed":1,"bbox":[0,0,1,1],"undone":[{"rev":7,"tx":"t_0007"}],"warnings":[]}

$ pxo redo --json
exit 0
--- stdout
{"ok":true,"rev":9,"changed":1,"bbox":[0,0,1,1],"redone":[{"rev":7,"tx":"t_0007"}],"warnings":[]}

$ pxo palette list --json
exit 0
--- stdout
{"ok":true,"key_width":1,"entries":[{"key":"o","name":"ink","color":"#1a1c2c"},{"key":"p","name":"plum","color":"#5d275d"},{"key":"r","name":"red","color":"#b13e53"},{"key":"c","name":"coral","color":"#ef7d57"},{"key":"y","name":"yellow","color":"#ffcd75"},{"key":"l","name":"lime","color":"#a7f070"},{"key":"g","name":"green","color":"#38b764"},{"key":"t","name":"teal","color":"#257179"},{"key":"n","name":"navy","color":"#29366f"},{"key":"b","name":"blue","color":"#3b5dc9"},{"key":"s","name":"sky","color":"#41a6f6"},{"key":"i","name":"ice","color":"#73eff7"},{"key":"w","name":"white","color":"#f4f4f4"},{"key":"f","name":"fog","color":"#94b0c2"},{"key":"a","name":"ash","color":"#566c86"},{"key":"d","name":"dusk","color":"#333c57"}],"ramps":{"blue":{"steps":["n","b","s","i"],"base":1},"gray":{"steps":["o","d","a","f","w"],"base":2},"green":{"steps":["t","g","l"],"base":1},"warm":{"steps":["p","r","c","y"],"base":2}}}

$ pxo ramp rm nosuch --json
exit 2
--- stdout
{"ok":false,"error":{"code":"unknown_color","message":"no ramp named \"nosuch\"","arg":"name"}}

$ pxo palette --help
exit 0
--- stdout
palette commands

Usage:
  pixopher palette [flags]
  pixopher palette [command]

Available Commands:
  add         Add a palette entry at the end
  list        List the palette entries (key, color, name) and the ramps
  rename      Rename a palette entry
  rm          Remove a palette entry; pixels using it need --replace
  set         Change a palette entry's color; every pixel using it changes

Flags:
  -h, --help   help for palette

Global Flags:
      --json   machine-readable output (PIXOPHER_JSON=1 turns it on everywhere)

Use "pixopher palette [command] --help" for more information about a command.

$ pxo palette rm --help
exit 0
--- stdout
Remove a palette entry; pixels using it need --replace

Arguments:
  entry  text; entry key or name

Usage:
  pixopher palette rm <entry> [flags]

Examples:
  pxo palette rm k
  pxo palette rm auto_ff0000 --replace red

Flags:
      --as string        author label (default $PIXOPHER_AUTHOR or cli)
      --dry-run          report the change without writing anything
      --expect-rev int   fail with rev_conflict unless the document is at this rev
  -f, --file string      document to act on (default: $PIXOPHER_FILE, the file set by use, or the only *.pxo here)
  -h, --help             help for rm
  -m, --message string   caption for this transaction
      --replace color    repaint pixels using the entry with this palette color

Global Flags:
      --json   machine-readable output (PIXOPHER_JSON=1 turns it on everywhere)

