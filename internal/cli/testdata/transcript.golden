{"ok":false,"error":{"code":"usage","message":"unexpected argument \"extra\"","hint":"see `pixopher version --help`"}}

$ pxo use --json
exit 1
--- stdout
{"ok":false,"error":{"code":"usage","message":"missing argument <file>","hint":"see `pixopher use --help`","arg":"file"}}

$ pxo use a.pxo b.pxo
exit 1
