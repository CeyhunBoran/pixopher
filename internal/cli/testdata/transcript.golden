{"ok":false,"error":{"code":"usage","message":"unknown command \"nope\" for \"pixopher\"","hint":"see `pixopher --help`"}}

$ pxo nope
exit 1
--- stderr
error[usage]: unknown command "nope" for "pixopher"
hint: see `pixopher --help`

$ pxo version --bogus --json
exit 1
