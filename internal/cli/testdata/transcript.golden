{"ok":false,"error":{"code":"no_file","message":"no document given and 2 .pxo files in the working directory: other.pxo, sprite.pxo","hint":"pass -f <file>, or pick one for this directory with `pxo use <file>`"}}

$ pxo mark 3,3 ink --json
exit 0
