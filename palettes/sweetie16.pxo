# Sweetie 16 by GrafxKid (see README.md), in its published order. Keys are
# the hex digits of each color's position.
pixopher = 1
size = [1, 1]

[palette]
0 = ["#1a1c2c", "ink"]
1 = ["#5d275d", "plum"]
2 = ["#b13e53", "red"]
3 = ["#ef7d57", "coral"]
4 = ["#ffcd75", "yellow"]
5 = ["#a7f070", "lime"]
6 = ["#38b764", "green"]
7 = ["#257179", "teal"]
8 = ["#29366f", "navy"]
9 = ["#3b5dc9", "blue"]
a = ["#41a6f6", "sky"]
b = ["#73eff7", "ice"]
c = ["#f4f4f4", "white"]
d = ["#94b0c2", "fog"]
e = ["#566c86", "ash"]
f = ["#333c57", "dusk"]

[ramps]
blue = ["8", "9", "a", "b"]
gray = ["0", "f", "e", "d", "c"]
green = ["7", "6", "5"]
warm = { steps = ["1", "2", "3", "4"], base = "3" }
